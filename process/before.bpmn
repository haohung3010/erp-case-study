<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_before" targetNamespace="https://example.org/tanmark">
  <bpmn:collaboration id="collab_before"><bpmn:participant id="pool_before" name="Tanmark Industries (fictional)" processRef="proc_before"/></bpmn:collaboration>
  <bpmn:process id="proc_before" name="Order to cash, before (paper, email and spreadsheets)" isExecutable="false">
    <bpmn:laneSet id="lanes_before">
      <bpmn:lane id="lane_before_0" name="Sales">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_before_1" name="Logistics">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_before_2" name="Purchasing">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_before_3" name="Warehouse">
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_before_4" name="Production">
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_before_5" name="Accounting">
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Customer phones or emails"/>
    <bpmn:task id="T1" name="Write a paper order form"/>
    <bpmn:task id="T2" name="Walk the shelves to check stock"/>
    <bpmn:exclusiveGateway id="G1" name="In stock?"/>
    <bpmn:task id="T3" name="Email supplier; note it in a spreadsheet"/>
    <bpmn:task id="T4" name="Receive materials; tick paper note"/>
    <bpmn:task id="T5" name="Build from a paper job card"/>
    <bpmn:task id="T6" name="Ship with a paper delivery note"/>
    <bpmn:task id="T7" name="Key the invoice into the accounting tool"/>
    <bpmn:task id="T8" name="Match payment to invoice by hand"/>
    <bpmn:task id="T9" name="Find overdue customers at the quarter-end statement"/>
    <bpmn:endEvent id="E1" name="Paid"/>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="T1"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" name="form carried"/>
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="G1"/>
    <bpmn:sequenceFlow id="F4" sourceRef="G1" targetRef="T3" name="no"/>
    <bpmn:sequenceFlow id="F5" sourceRef="G1" targetRef="T6" name="yes"/>
    <bpmn:sequenceFlow id="F6" sourceRef="T3" targetRef="T4"/>
    <bpmn:sequenceFlow id="F7" sourceRef="T4" targetRef="T5"/>
    <bpmn:sequenceFlow id="F8" sourceRef="T5" targetRef="T6"/>
    <bpmn:sequenceFlow id="F9" sourceRef="T6" targetRef="T7" name="paper copies"/>
    <bpmn:sequenceFlow id="F10" sourceRef="T7" targetRef="T8"/>
    <bpmn:sequenceFlow id="F11" sourceRef="T8" targetRef="T9"/>
    <bpmn:sequenceFlow id="F12" sourceRef="T9" targetRef="E1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="dia_before"><bpmndi:BPMNPlane id="plane_before" bpmnElement="collab_before">
    <bpmndi:BPMNShape id="pool_before_di" bpmnElement="pool_before" isHorizontal="true"><dc:Bounds x="0" y="20" width="1970" height="720"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="lane_before_0_di" bpmnElement="lane_before_0" isHorizontal="true"><dc:Bounds x="30" y="20" width="1940" height="120"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="lane_before_1_di" bpmnElement="lane_before_1" isHorizontal="true"><dc:Bounds x="30" y="140" width="1940" height="120"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="lane_before_2_di" bpmnElement="lane_before_2" isHorizontal="true"><dc:Bounds x="30" y="260" width="1940" height="120"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="lane_before_3_di" bpmnElement="lane_before_3" isHorizontal="true"><dc:Bounds x="30" y="380" width="1940" height="120"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="lane_before_4_di" bpmnElement="lane_before_4" isHorizontal="true"><dc:Bounds x="30" y="500" width="1940" height="120"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="lane_before_5_di" bpmnElement="lane_before_5" isHorizontal="true"><dc:Bounds x="30" y="620" width="1940" height="120"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="207" y="62" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="315" y="50" width="120" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="465" y="170" width="120" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="G1_di" bpmnElement="G1"><dc:Bounds x="650" y="175" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="765" y="290" width="120" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="915" y="410" width="120" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="1065" y="530" width="120" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T6_di" bpmnElement="T6"><dc:Bounds x="1215" y="410" width="120" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T7_di" bpmnElement="T7"><dc:Bounds x="1365" y="650" width="120" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T8_di" bpmnElement="T8"><dc:Bounds x="1515" y="650" width="120" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T9_di" bpmnElement="T9"><dc:Bounds x="1665" y="650" width="120" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="1857" y="662" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="243" y="80"/><di:waypoint x="315" y="80"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="435" y="80"/><di:waypoint x="450" y="80"/><di:waypoint x="450" y="200"/><di:waypoint x="465" y="200"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="585" y="200"/><di:waypoint x="650" y="200"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="700" y="200"/><di:waypoint x="750" y="200"/><di:waypoint x="750" y="320"/><di:waypoint x="765" y="320"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="700" y="200"/><di:waypoint x="1200" y="200"/><di:waypoint x="1200" y="440"/><di:waypoint x="1215" y="440"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="885" y="320"/><di:waypoint x="900" y="320"/><di:waypoint x="900" y="440"/><di:waypoint x="915" y="440"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="1035" y="440"/><di:waypoint x="1050" y="440"/><di:waypoint x="1050" y="560"/><di:waypoint x="1065" y="560"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1185" y="560"/><di:waypoint x="1200" y="560"/><di:waypoint x="1200" y="440"/><di:waypoint x="1215" y="440"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1335" y="440"/><di:waypoint x="1350" y="440"/><di:waypoint x="1350" y="680"/><di:waypoint x="1365" y="680"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1485" y="680"/><di:waypoint x="1515" y="680"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1635" y="680"/><di:waypoint x="1665" y="680"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1785" y="680"/><di:waypoint x="1857" y="680"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
