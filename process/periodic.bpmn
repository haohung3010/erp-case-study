    <bpmndi:BPMNShape id="E4_di" bpmnElement="E4"><dc:Bounds x="1707" y="182" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="S3_di" bpmnElement="S3"><dc:Bounds x="1857" y="422" width="36" height="36"/></bpmndi:BPMNShape>
