<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_periodic" targetNamespace="https://example.org/tanmark">
  <bpmn:collaboration id="collab_periodic"><bpmn:participant id="pool_periodic" name="Tanmark Industries (fictional)" processRef="proc_periodic"/></bpmn:collaboration>
  <bpmn:process id="proc_periodic" name="Periodic routines, after: ageing, reconciliations and price lists" isExecutable="false">
    <bpmn:laneSet id="lanes_periodic">
      <bpmn:lane id="lane_periodic_0" name="Sales">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_periodic_1" name="Warehouse">
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_periodic_2" name="Price control">
        <bpmn:flowNodeRef>S4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_periodic_3" name="Accounting">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Each week"/>
    <bpmn:task id="T1" name="Run the ageing view of open invoices"/>
    <bpmn:exclusiveGateway id="G1" name="Overdue or over the limit?"/>
    <bpmn:task id="T2" name="Contract on credit hold; sales chases the customer"/>
    <bpmn:endEvent id="E1" name="Chased"/>
    <bpmn:endEvent id="E2" name="Nothing overdue"/>
    <bpmn:startEvent id="S2" name="Month end"/>
    <bpmn:task id="T3" name="Count stock"/>
    <bpmn:task id="T4" name="Reconcile the count with the books"/>
    <bpmn:exclusiveGateway id="G2" name="Any difference?"/>
    <bpmn:endEvent id="E3" name="Reconciled"/>
    <bpmn:task id="T5" name="Find the step that skipped the system; sign off the difference"/>
    <bpmn:endEvent id="E4" name="Signed off"/>
    <bpmn:startEvent id="S3" name="Quarter end"/>
    <bpmn:task id="T6" name="Send each customer its statement of open invoices"/>
    <bpmn:task id="T7" name="Customer signs, or disputes a line"/>
    <bpmn:exclusiveGateway id="G3" name="Signed?"/>
    <bpmn:endEvent id="E5" name="Reconciled"/>
    <bpmn:task id="T8" name="Resolve the dispute; credit note if owed"/>
    <bpmn:endEvent id="E6" name="Resolved"/>
    <bpmn:startEvent id="S4" name="Supplier sends a new price list"/>
    <bpmn:task id="T9" name="Load it one week before it takes effect"/>
    <bpmn:endEvent id="E7" name="Loaded on time"/>
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="G1"/>
    <bpmn:sequenceFlow id="F3" sourceRef="G1" targetRef="T2" name="yes"/>
    <bpmn:sequenceFlow id="F4" sourceRef="G1" targetRef="E2" name="no"/>
    <bpmn:sequenceFlow id="F5" sourceRef="T2" targetRef="E1"/>
    <bpmn:sequenceFlow id="F6" sourceRef="S2" targetRef="T3"/>
    <bpmn:sequenceFlow id="F7" sourceRef="T3" targetRef="T4"/>
    <bpmn:sequenceFlow id="F8" sourceRef="T4" targetRef="G2"/>
    <bpmn:sequenceFlow id="F9" sourceRef="G2" targetRef="E3" name="no"/>
    <bpmn:sequenceFlow id="F10" sourceRef="G2" targetRef="T5" name="yes"/>
    <bpmn:sequenceFlow id="F11" sourceRef="T5" targetRef="E4"/>
    <bpmn:sequenceFlow id="F12" sourceRef="S3" targetRef="T6"/>
    <bpmn:sequenceFlow id="F13" sourceRef="T6" targetRef="T7"/>
    <bpmn:sequenceFlow id="F14" sourceRef="T7" targetRef="G3"/>
    <bpmn:sequenceFlow id="F15" sourceRef="G3" targetRef="E5" name="yes"/>
    <bpmn:sequenceFlow id="F16" sourceRef="G3" targetRef="T8" name="no"/>
    <bpmn:sequenceFlow id="F17" sourceRef="T8" targetRef="E6"/>
    <bpmn:sequenceFlow id="F18" sourceRef="S4" targetRef="T9"/>
    <bpmn:sequenceFlow id="F19" sourceRef="T9" targetRef="E7"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="dia_periodic"><bpmndi:BPMNPlane id="plane_periodic" bpmnElement="collab_periodic">
    <bpmndi:BPMNShape id="pool_periodic_di" bpmnElement="pool_periodic" isHorizontal="true"><dc:Bounds x="0" y="20" width="3170" height="480"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="lane_periodic_0_di" bpmnElement="lane_periodic_0" isHorizontal="true"><dc:Bounds x="30" y="20" width="3140" height="120"/></bpmndi:BPMNShape>
