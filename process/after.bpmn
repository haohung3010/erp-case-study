  <bpmn:collaboration id="collab_after"><bpmn:participant id="pool_after" name="Tanmark Industries (fictional)" processRef="proc_after"/></bpmn:collaboration>
  <bpmn:process id="proc_after" name="Order to cash and procure to pay, after (one system, one data model)" isExecutable="false">
    <bpmn:laneSet id="lanes_after">
      <bpmn:lane id="lane_after_0" name="Sales">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_after_1" name="Logistics">
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_after_2" name="Purchasing">
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_after_3" name="Warehouse">
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T16</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_after_4" name="Production">
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_after_5" name="Accounting">
        <bpmn:flowNodeRef>T18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Customer places an order"/>
    <bpmn:task id="T1" name="Save order request"/>
    <bpmn:exclusiveGateway id="G5" name="Contract on credit hold?"/>
    <bpmn:task id="T18" name="Chief accountant releases, with a reason"/>
    <bpmn:task id="T2" name="Confirm order"/>
    <bpmn:task id="T3" name="Send to logistics; sales editing locks"/>
    <bpmn:exclusiveGateway id="G0" name="Order withdrawn?"/>
    <bpmn:task id="T14" name="Cancel the order (before production)"/>
    <bpmn:endEvent id="E4" name="Cancelled"/>
    <bpmn:exclusiveGateway id="G1" name="Finished goods in stock?"/>
    <bpmn:task id="T4" name="Raise material request"/>
    <bpmn:exclusiveGateway id="G2" name="Materials in stock?"/>
    <bpmn:task id="T5" name="Create purchase order (signed on paper)"/>
    <bpmn:task id="T6" name="Receive into stock; order counts as approved"/>
    <bpmn:parallelGateway id="P1" name=""/>
    <bpmn:task id="T7" name="Issue materials to the workshop"/>
    <bpmn:task id="T13" name="Record supplier invoice; post payment"/>
    <bpmn:endEvent id="E2" name="Supplier paid"/>
    <bpmn:task id="T8" name="Build and test the goods"/>
    <bpmn:exclusiveGateway id="G3" name="Order still wanted?"/>
    <bpmn:task id="T15" name="Close as not completed; stock kept"/>
    <bpmn:endEvent id="E5" name="Not completed"/>
    <bpmn:task id="T9" name="Receive finished goods"/>
    <bpmn:task id="T10" name="Plan delivery trips"/>
    <bpmn:task id="T16" name="Issue goods to the trip; form numbered"/>
    <bpmn:task id="T11" name="Raise the trip&#x27;s invoice"/>
    <bpmn:task id="T17" name="Dispatch with the invoice; deliver"/>
    <bpmn:parallelGateway id="P2" name=""/>
    <bpmn:endEvent id="E1" name="Order Completed"/>
    <bpmn:task id="T12" name="Collect on terms; post receipt voucher"/>
    <bpmn:endEvent id="E3" name="Paid"/>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="T1"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="G5"/>
    <bpmn:sequenceFlow id="F3" sourceRef="G5" targetRef="T2" name="no"/>
    <bpmn:sequenceFlow id="F4" sourceRef="G5" targetRef="T18" name="yes"/>
